msgstr "Créez un compte Book Corners pour ajouter de nouvelles boîtes à livres et tenir les fiches locales à jour."

#: users/templates/users/register.html:12
msgid "Join to submit libraries and help keep information up to date."
msgstr "Inscrivez-vous pour ajouter des boîtes à livres et aider à garder les informations à jour."

#: users/templates/users/register.html:40
msgid "Confirm password"
msgstr "Confirmez le mot de passe"

#: users/templates/users/register.html:48
msgid "The agreement lets Book Corners use and share the data and images you contribute. It applies to your contributions, not your account details."
msgstr "Cet accord permet à Book Corners d'utiliser et de partager les données et les images que vous apportez. Il s'applique à vos contributions, pas aux informations de votre compte."

#: users/templates/users/register.html:53
msgid "I have read and accept the"
msgstr "J'ai lu et j'accepte"

#: users/templates/users/register.html:55
#, python-format
msgid "Contributor Agreement v%(agreement_version)s"
msgstr "l'Accord de contribution v%(agreement_version)s"

#: users/templates/users/register.html:64
msgid "Create account"
msgstr "Créer le compte"

#: users/templates/users/register.html:93
msgid "Already have an account?"
msgstr "Vous avez déjà un compte ?"

#: users/views.py:117
msgid "Too many registration attempts. Please try again in a few minutes."
msgstr "Trop de tentatives d'inscription. Veuillez réessayer dans quelques minutes."

#: users/views.py:197
msgid "Too many login attempts. Please try again in a few minutes."
msgstr "Trop de tentatives de connexion. Veuillez réessayer dans quelques minutes."

#: users/views.py:237
msgid "Social login accounts cannot change their email address."
msgstr "Les comptes de connexion sociale ne peuvent pas changer leur adresse e-mail."

#: users/views.py:243
msgid "Your email address has been updated."
msgstr "Votre adresse e-mail a été mise à jour."

#: users/views.py:253
msgid "Social login accounts cannot change their password."
msgstr "Les comptes de connexion sociale ne peuvent pas changer leur mot de passe."

#: users/views.py:259
msgid "Your password has been changed."
msgstr "Votre mot de passe a été modifié."

#: users/views.py:277
msgid "Your account has been deleted."
msgstr "Votre compte a été supprimé."

